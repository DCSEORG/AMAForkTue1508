@page
@model ApproveExpensesModel
@{
    ViewData["Title"] = "Approve Expenses";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Approve Expenses</h2>
        </div>
        <div class="card-body">
            <h3>Pending expenses:</h3>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <form method="get" class="input-group">
                        <input type="text" name="filter" class="form-control" placeholder="Filter..." value="@Model.FilterText" />
                        <button class="btn btn-outline-secondary" type="submit">Search</button>
                        @if (!string.IsNullOrEmpty(Model.FilterText))
                        {
                            <a href="/ApproveExpenses" class="btn btn-outline-danger">Clear</a>
                        }
                    </form>
                </div>
                <div class="col-md-6 text-end">
                    <a href="/Index" class="btn btn-secondary">Back to Expenses</a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PendingExpenses.Any())
                        {
                            @foreach (var expense in Model.PendingExpenses)
                            {
                                <tr>
                                    <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                    <td>@expense.CategoryName</td>
                                    <td>£@expense.Amount.ToString("F2")</td>
                                    <td>@expense.Description</td>
                                    <td>
                                        <form method="post" style="display: inline;">
                                            <input type="hidden" name="expenseId" value="@expense.ExpenseId" />
                                            <button type="submit" asp-page-handler="Approve" class="btn btn-sm btn-success me-1">
                                                ✓ Approve
                                            </button>
                                            <button type="submit" asp-page-handler="Reject" class="btn btn-sm btn-danger">
                                                ✗ Reject
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">No pending expenses</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
