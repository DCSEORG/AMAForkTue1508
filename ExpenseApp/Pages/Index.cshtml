@page
@model IndexModel
@{
    ViewData["Title"] = "Expenses";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0">Expense Management System</h2>
        </div>
        <div class="card-body">
            <h3>My Expenses</h3>
            
            <div class="row mb-3">
                <div class="col-md-6">
                    <form method="get" class="input-group">
                        <input type="text" name="filter" class="form-control" placeholder="Filter expenses..." value="@Model.FilterText" />
                        <button class="btn btn-outline-secondary" type="submit">Search</button>
                        @if (!string.IsNullOrEmpty(Model.FilterText))
                        {
                            <a href="/Index" class="btn btn-outline-danger">Clear</a>
                        }
                    </form>
                </div>
                <div class="col-md-6 text-end">
                    <a href="/AddExpense" class="btn btn-success">+ Add New Expense</a>
                    <a href="/ApproveExpenses" class="btn btn-warning">Approve Expenses</a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Category</th>
                            <th>Amount</th>
                            <th>Status</th>
                            <th>Description</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Expenses.Any())
                        {
                            @foreach (var expense in Model.Expenses)
                            {
                                <tr>
                                    <td>@expense.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                    <td>@expense.CategoryName</td>
                                    <td>£@expense.Amount.ToString("F2")</td>
                                    <td>
                                        @if (expense.StatusName == "Approved")
                                        {
                                            <span class="badge bg-success">@expense.StatusName</span>
                                        }
                                        else if (expense.StatusName == "Rejected")
                                        {
                                            <span class="badge bg-danger">@expense.StatusName</span>
                                        }
                                        else if (expense.StatusName == "Submitted")
                                        {
                                            <span class="badge bg-warning text-dark">@expense.StatusName</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@expense.StatusName</span>
                                        }
                                    </td>
                                    <td>@expense.Description</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">No expenses found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <a href="/swagger" class="btn btn-info" target="_blank">View API Documentation</a>
            </div>
        </div>
    </div>
</div>

